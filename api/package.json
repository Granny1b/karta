{
  "name": "karta-api",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/api/src/functions/*.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/smoke-load.mjs",
    "watch": "tsc -p tsconfig.build.json -w",
    "prestart": "npm run build",
    "start": "func start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@azure/functions": "^4.6.0",
    "@azure/storage-blob": "^12.25.0",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "typescript": "^5.6.3"
  }
}
